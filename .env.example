# Copy to .env and fill in. Both processes (bot.py + tgbot.py) read this file.

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID. The bot will ONLY respond to this user.
TELEGRAM_ADMIN_ID=

# Worker behaviour ---------------------------------------------------
# How often to ping you that the worker is still alive (hours). 0 disables.
HEARTBEAT_HOURS=12

# Send a Telegram notification on every successful claim. Default off; an
# end-of-cycle digest is sent regardless.
NOTIFY_PER_CLAIM=false
